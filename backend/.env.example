# Copy to .env (or set these as real env vars/platform secrets) and fill in. None of these are read
# from a .env file automatically by Spring Boot - this documents what `application.properties` expects
# via ${VAR:default}; wire them in however your platform does env vars (Render: service settings).

# --- Database ---
# Set DB_URL directly (full JDBC URL). Required for Supabase - its Postgres needs sslmode=require, and
# DB_URL is the only place to add it:
# DB_URL=jdbc:postgresql://db.xxxxxxxx.supabase.co:5432/postgres?sslmode=require
# DB_USER=postgres
# DB_PASSWORD=your-supabase-db-password
#
# Use Supabase's "Session" pooler mode if you use the pooler host at all, not "Transaction" mode -
# Hibernate relies on server-side prepared statements, which transaction-mode pgbouncer doesn't
# support correctly.
#
# ...or, if your platform provides Postgres by individual field (e.g. Render's own managed Postgres via
# `fromDatabase`), set these instead - DB_URL is built from them when DB_URL itself isn't set:
# PGHOST=
# PGPORT=5432
# PGDATABASE=shipstream
# PGUSER=
# PGPASSWORD=

# --- Auth ---
# Required for anything beyond local dev - the default in application.properties is intentionally
# public (documented there), so tokens signed with it can be forged by anyone who reads the source.
JWT_SECRET=change-me-to-a-real-random-32-byte-secret

# Demo ops login, seeded on startup if it doesn't exist (DemoUserSeeder). Leave as the defaults for a
# public demo deployment, or override for anything meant to look like a real login.
DEMO_OPS_USERNAME=demo
DEMO_OPS_PASSWORD=demo1234

# Cookies need Secure (HTTPS-only) in any real deployment. false is only correct for local http dev.
COOKIE_SECURE=true

# Lax if frontend and backend share a registrable domain; None if they're on genuinely different ones
# (e.g. a Vercel frontend + this backend on Render) - Lax cookies aren't sent on cross-site fetch/XHR
# at all, so login would silently never attach the cookie. None requires COOKIE_SECURE=true.
COOKIE_SAME_SITE=None

# --- CORS ---
# Comma-separated list of the frontend's real origin(s), no trailing slash. Without this, a deployed
# frontend can't call this API at all - the backend will reject every cross-origin request.
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
