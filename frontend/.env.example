# Copy to .env.local for local overrides, or set as a build-time var on your deploy platform. Vite
# only exposes variables prefixed VITE_ to client code, and bakes them into the bundle at build time
# (there's no server at runtime to read env vars from - it's a static SPA) - so for Docker, this has to
# be passed as a --build-arg, not a plain runtime ENV (see frontend/Dockerfile).

# Defaults to http://localhost:8080 if unset (src/api/client.ts). Set to the deployed backend's URL.
VITE_API_URL=https://your-backend.example.com
